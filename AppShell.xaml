<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QuestionDB.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QuestionDB"
    Title="QuestionDB">

    <local:MainPage/>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState Name="Phone">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowHeight="700" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Property="Shell.HeightRequest" Value="900" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Shell>
